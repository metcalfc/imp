UPSTREAM = "https://api.anthropic.com"

# Claude Code drops oauth-2025-04-20 from its beta list when it has no local
# OAuth credentials -- which is exactly the state the sprite is in. Without it
# the Max entitlement is not honoured, so we put it back on the way out.
REQUIRED_BETAS = ("claude-code-20250219", "oauth-2025-04-20")

# A hostile sprite gets to choose the request path, so the proxy is otherwise an
# open relay to your account for the length of the session. Only inference
# endpoints are worth reaching through here; everything else is refused before
# the credential is ever attached. Extend with --allow, escape with
# --allow-any-path.
DEFAULT_ALLOWED = (
    "/v1/messages",
    "/v1/messages/count_tokens",
    "/v1/models",
    "/v1/models/*",
)

HDR = struct.Struct("!IBI")
T_OPEN, T_DATA, T_CLOSE, T_PING = 1, 2, 3, 4

PING_EVERY = 10.0
LINK_TIMEOUT = 60.0
RELAY_IDLE_TIMEOUT = 30.0

# A hostile sprite gets to declare how much we should allocate for it. None of
# these are tuning knobs -- they exist so that a number chosen on the far end
# cannot exhaust memory, threads or descriptors on this machine.
MAX_BODY = 64 * 1024 * 1024     # generous next to a large image request
MAX_FRAME = 1024 * 1024         # the relay never sends more than 64KB
MAX_STREAMS = 256               # concurrent proxied connections
# Per-stream write buffer before a consumer is written off as stuck. A claude
# that pauses to render a long response is slow, not stuck -- be generous.
MAX_STREAM_BUFFER = 8 * 1024 * 1024
SETTINGS_TIMEOUT = 30.0         # ssh round trip for settings.json


def log(*a):
    sys.stderr.write("[imp] " + " ".join(str(x) for x in a) + "\n")
    sys.stderr.flush()


def die(*lines):
    for line in lines:
        log(line)
    raise SystemExit(2)


# --------------------------------------------------------------------------
# credential lookup (macOS + Linux)
# --------------------------------------------------------------------------

def _run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        return None


def _extract_token(blob):
    """A credential blob is either a bare token or JSON holding accessToken."""
    blob = blob.strip()
    if not blob:
        return None
    try:
        data = json.loads(blob)
    except ValueError:
        return blob

    found = []

    def walk(o):
        if isinstance(o, dict):
            for k, v in o.items():
                if k == "accessToken" and isinstance(v, str):
                    found.append(v)
                else:
                    walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    walk(data)
    return found[0] if found else None


def load_credential():
    """Return (token, human-readable source). Never logged, never written out.

    Preferred: the dedicated setup-token minted by imp-auth, which is
    long-lived and inference-only. Falls back to this machine's live Claude
    login, which works but carries a short-lived access token -- see --help.
    """
    darwin = platform.system() == "Darwin"
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or ""

    if darwin:
        candidates = [
            (["security", "find-generic-password", "-s", "imp-oauth",
              "-a", user, "-w"], "macOS keychain (imp-oauth, setup-token)"),
            (["security", "find-generic-password", "-s", "Claude Code-credentials",
              "-a", user, "-w"], "macOS keychain (live Claude login)"),
        ]
        for cmd, source in candidates:
            r = _run(cmd)
            if r is not None and r.returncode == 0:
                tok = _extract_token(r.stdout)
                if tok:
                    return tok, source
    else:
        path = os.path.expanduser("~/.claude/.credentials.json")
        if os.path.exists(path):
            with open(path) as f:
                tok = _extract_token(f.read())
            if tok:
                return tok, path
        for service in ("imp-oauth", "Claude Code-credentials"):
            r = _run(["secret-tool", "lookup", "service", service])
            if r is not None and r.returncode == 0:
                tok = _extract_token(r.stdout)
                if tok:
                    return tok, "secret-tool (%s)" % service

    env = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")
    if env:
        return env.strip(), "CLAUDE_CODE_OAUTH_TOKEN in this environment"

    raise SystemExit(
        "no Claude credential found.\n"
        "  Mint a dedicated one:  claude setup-token   (then store it as\n"
        "  'imp-oauth' in your keychain), or just log in with `claude`."
    )


# --------------------------------------------------------------------------
# the injecting proxy — the only thing that ever sees the real token
# --------------------------------------------------------------------------

# Decoding is repeated until it stops changing, so %252e%252e cannot hide a
# traversal behind one round of unescaping. A handful of rounds is far more
# than any real target needs; the cap only stops a pathological input.
MAX_DECODE_ROUNDS = 5


def _fully_decoded(path):
    """Percent-decode until stable, or None if it will not settle."""
    for _ in range(MAX_DECODE_ROUNDS):
        nxt = urllib.parse.unquote(path)
        if nxt == path:
            return path
        path = nxt
    return None


def normalize_path(raw):
    """Canonical path to authorize *and* to forward, or None if unsafe.

    The value returned here is what actually goes upstream. Authorizing one
    spelling and forwarding another is how an allowlist gets walked past:
    %2e%2e survives posixpath.normpath untouched, so a check on the raw target
    sees nothing wrong while whatever decodes it downstream sees `..`.

    So: decode first, refuse anything whose decoded form is not already
    normal, and re-encode that decoded form for the wire. What is checked and
    what is sent are then the same string by construction.
    """
    if not raw.startswith("/"):
        return None
    path = raw.split("#", 1)[0].split("?", 1)[0]

    decoded = _fully_decoded(path)
    if decoded is None or not decoded.startswith("/"):
        return None
    # Backslashes and control bytes have no place in a target and are a
    # standard way to confuse whatever parses it next.
    if "\\" in decoded or any(c < " " or c == "\x7f" for c in decoded):
        return None

    norm = posixpath.normpath(decoded)
    if norm != decoded and norm != decoded.rstrip("/"):
        return None
    return urllib.parse.quote(norm, safe="/")


def _glob_to_re(pat):
    """`*` matches within one path segment, `**` spans segments.

    fnmatch's `*` crosses `/`, which makes /v1/models/* mean "anything under
    /v1/models" rather than "one model id" -- a much wider grant than it
    looks. Path globs should behave the way shell globs do.
    """
    out, i = [], 0
    while i < len(pat):
        c = pat[i]
        if c == "*":
            if pat.startswith("**", i):
                out.append(".*")
                i += 2
            else:
                out.append("[^/]*")
                i += 1
        elif c == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(c))
            i += 1
    return re.compile("".join(out) + r"\Z")


_GLOB_CACHE = {}


def path_allowed(path, patterns):
    if not patterns:            # --allow-any-path
        return True
    for pat in patterns:
        rx = _GLOB_CACHE.get(pat)
        if rx is None:
            rx = _GLOB_CACHE[pat] = _glob_to_re(pat)
        if rx.match(path):
            return True
    return False


HOP = {"host", "accept-encoding", "content-length", "connection", "keep-alive",
       "proxy-authenticate", "proxy-authorization", "te", "trailers",
       "transfer-encoding", "upgrade"}


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse to follow redirects.

    urllib's default handler copies Authorization into the redirected request
    without checking the origin, so a 3xx would hand the real token to
    whatever host the Location names. Returning None leaves the 3xx to
    surface as an HTTPError, which we pass back to the sprite verbatim --
    it can decide what to do with it, without our credential.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


OPENER = urllib.request.build_opener(_NoRedirect)


def _drop(conn):
    """Close a proxied socket that another thread may be blocked reading.

    Same reason as the relay's drop(): close() alone does not reliably wake a
    thread parked in recv(), nor guarantee the peer sees EOF.
    """
    try:
        conn.shutdown(socket.SHUT_RDWR)
    except OSError:
        pass
    try:
        conn.close()
    except OSError:
        pass


def _close(resp):
    """Release an upstream response -- an HTTPError body holds a socket too."""
    try:
        resp.close()
    except Exception:
        pass


class Credential(object):
    """Holds the live token. Re-read on a 401 so a long session survives the
    access token rolling underneath it -- Claude Code on this machine refreshes
    the keychain entry, we just notice."""

    def __init__(self):
        self.token, self.source = load_credential()
        self.lock = threading.Lock()

    def refresh(self):
        with self.lock:
            old = self.token
            try:
                self.token, self.source = load_credential()
            except SystemExit as e:
                log("credential refresh failed: %s" % e)
                return False
            return self.token != old


def make_proxy_handler(cred, capability, verbose, allowed):
    import http.server

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *args):
            pass

        # The target is the sprite's to choose, so it reaches our terminal
        # only as printable ASCII, clipped: a request line can carry 64 KB of
        # escape sequences, and a rejection is exactly when it is unvetted.
        def _safe_target(self):
            raw = getattr(self, "path", None) or "-"
            clean = "".join(c if " " <= c <= "~" else "?" for c in raw)
            return clean if len(clean) <= 120 else clean[:120] + "..."

        def _reject(self, code, why):
            # Logged, not returned: the body says what was wrong, and the
            # sprite already knows what it asked for.
            log("rejected: %s (%s %s)" % (why, self.command, self._safe_target()))
            body = json.dumps({"type": "error", "error": {
                "type": "authentication_error", "message": why}}).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            # We may be refusing before reading the request body, so this
            # connection cannot be reused -- whatever is still in flight would
            # be parsed as the next request line.
            self.send_header("Connection", "close")
            self.close_connection = True
            self.end_headers()
            self.wfile.write(body)

        def _proxy(self):
            path = normalize_path(self.path)
            if path is None:
                self._reject(400, "malformed request path")
                return
            if not path_allowed(path, allowed):
                self._reject(403, "path is not on the allowlist")
                return
            # Forward the target we authorized, not the one we were handed.
            target = path
            q = self.path.split("#", 1)[0].split("?", 1)
            if len(q) == 2:
                target += "?" + q[1]

            fwd = {k: v for k, v in self.headers.items() if k.lower() not in HOP}
            fwd["Accept-Encoding"] = "identity"

            # Strip *every* credential header the sprite sent, not just the
            # first -- `presented or fwd.pop(k)` would short-circuit and
            # forward a second one upstream alongside the real token.
            presented = ""
            for k in list(fwd):
                if k.lower() in ("authorization", "x-api-key"):
                    v = fwd.pop(k)
                    presented = presented or v
            presented = presented[7:] if presented.lower().startswith("bearer ") else presented

            # Before the body is read, not after: Content-Length is chosen by
            # the sprite, and reading it first hands an unauthenticated caller
            # a blocking allocation of whatever size it likes.
            if not presented or presented.strip() != capability:
                self._reject(403, "bad or missing session capability")
                return

            n = self.headers.get("Content-Length")
            try:
                length = int(n) if n else 0
            except ValueError:
                self._reject(400, "malformed Content-Length")
                return
            if length < 0:
                # rfile.read(-1) would read to EOF -- unbounded, by way of a
                # value that merely looks like a number.
                self._reject(400, "negative Content-Length")
                return
            if length > MAX_BODY:
                self._reject(413, "request body of %d bytes exceeds the %d byte limit"
                             % (length, MAX_BODY))
                return
            body = self.rfile.read(length) if length else b""

            fwd["Authorization"] = "Bearer " + cred.token
            betas = [b for b in (fwd.get("anthropic-beta") or "").split(",") if b]
            for b in REQUIRED_BETAS:
                if b not in betas:
                    betas.insert(0, b)
            if betas:
                fwd["anthropic-beta"] = ",".join(betas)

            if verbose:
                log("%s %s (%d bytes up)" % (self.command, target, len(body)))

            def attempt():
                req = urllib.request.Request(UPSTREAM + target, data=body or None,
                                             headers=fwd, method=self.command)
                try:
                    r = OPENER.open(req, timeout=600)
                    return r, r.getcode(), None
                except urllib.error.HTTPError as e:
                    return e, e.code, None
                except Exception as e:
                    return None, None, e

            resp, code, err = attempt()
            if code == 401 and cred.refresh():
                log("upstream 401 -- reloaded credential, retrying")
                _close(resp)          # the 401 body still owns a socket
                fwd["Authorization"] = "Bearer " + cred.token
                resp, code, err = attempt()
            if err is not None:
                log("upstream error: %r" % (err,))
                self._reject(502, "upstream error")
                return

            self.send_response(code)
            for k, v in resp.headers.items():
                if k.lower() not in HOP:
                    self.send_header(k, v)
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()

            # Streamed verbatim so SSE arrives token-by-token, not buffered.
            try:
                while True:
                    chunk = resp.read(4096)
                    if not chunk:
                        break
                    self.wfile.write(b"%x\r\n" % len(chunk) + chunk + b"\r\n")
                    self.wfile.flush()
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()
            finally:
                _close(resp)

        do_GET = do_POST = do_PUT = do_DELETE = _proxy

    return Handler


class ProxyServer(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request, client_address):
        """A client hanging up mid-request is routine -- `claude` does it on
        every Ctrl-C. socketserver's default would dump a traceback for it.
        Anything genuinely unexpected gets one line, never headers or bodies."""
        exc = sys.exc_info()[1]
        if isinstance(exc, (ConnectionResetError, BrokenPipeError,
                            ConnectionAbortedError, socket.timeout)):
            return
        log("connection error: %r" % (exc,))


# --------------------------------------------------------------------------
# the relay that runs on the sprite (shipped as base64 in argv, never a file)
# --------------------------------------------------------------------------

RELAY_SRC = r'''
import os, queue, socket, struct, sys, threading, time

PORT = int(sys.argv[1])
IDLE = float(sys.argv[2])
# Per-stream buffer before a consumer is written off as stuck. Generous: a
# claude that pauses to render a long response is slow, not stuck.
MAX_BUF = 8 * 1024 * 1024
HDR = struct.Struct("!IBI")
T_OPEN, T_DATA, T_CLOSE, T_PING = 1, 2, 3, 4

out = sys.stdout.buffer
inp = sys.stdin.buffer
streams = {}
slock = threading.Lock()
last = [time.time()]

# A bounded queue drained by one writer thread. Producers are per-stream pump
# threads, so blocking one when the channel backs up is correct backpressure
# for that stream alone -- unlike holding a lock across the write, which
# stalled every stream at once.
outq = queue.Queue(maxsize=256)


def drop(conn):
    # shutdown() before close(): another thread is blocked in recv() on this
    # socket, and close() alone neither reliably wakes it nor guarantees the
    # peer sees EOF. shutdown() does both.
    try:
        conn.shutdown(socket.SHUT_RDWR)
    except OSError:
        pass
    try:
        conn.close()
    except OSError:
        pass


def send(sid, t, payload=b""):
    outq.put(HDR.pack(sid, t, len(payload)) + payload)


def chan_writer():
    while True:
        buf = outq.get()
        try:
            out.write(buf)
            out.flush()
        except (OSError, ValueError):
            os._exit(0)


class Stream(object):
    """A socket plus its own writer thread.

    The frame reader must never block: one consumer that stops draining would
    otherwise stall every other stream, and -- because the reader is also what
    refreshes the idle timestamp -- trip the watchdog into killing the whole
    session 30s later.
    """

    def __init__(self, sid, conn):
        self.sid = sid
        self.conn = conn
        self.q = queue.Queue()
        self.buffered = 0
        self.lock = threading.Lock()
        self.closed = False
        threading.Thread(target=self.writer, daemon=True).start()

    def feed(self, data):
        """Hand off without blocking. True if accepted."""
        with self.lock:
            if self.closed:
                return False
            if self.buffered + len(data) > MAX_BUF:
                return False        # genuinely stuck; caller drops the stream
            self.buffered += len(data)
        self.q.put(data)
        return True

    def writer(self):
        while True:
            data = self.q.get()
            if data is None:
                break
            try:
                self.conn.sendall(data)
            except OSError:
                break
            with self.lock:
                self.buffered -= len(data)
        self.close()

    def close(self):
        with self.lock:
            if self.closed:
                return
            self.closed = True
        self.q.put(None)
        drop(self.conn)


def pump(sid, st):
    try:
        while True:
            b = st.conn.recv(65536)
            if not b:
                break
            send(sid, T_DATA, b)     # may block on outq; that is this stream's
    except OSError:                  # backpressure, not everyone else's
        pass
    finally:
        with slock:
            streams.pop(sid, None)
        send(sid, T_CLOSE)
        st.close()


def acceptor():
    srv = socket.socket()
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind(("127.0.0.1", PORT))
    except OSError as e:
        sys.stderr.write("relay: cannot bind 127.0.0.1:%d: %s\n" % (PORT, e))
        sys.stderr.flush()
        os._exit(1)
    srv.listen(64)
    sys.stderr.write("relay listening on 127.0.0.1:%d\n" % PORT)
    sys.stderr.flush()
    # Tell the other end the link is genuinely up. Nothing is "ready" before
    # this frame arrives.
    send(0, T_PING)
    n = 0
    while True:
        conn, _ = srv.accept()
        n += 1
        st = Stream(n, conn)
        with slock:
            streams[n] = st
        send(n, T_OPEN)
        threading.Thread(target=pump, args=(n, st), daemon=True).start()


def watchdog():
    # The sprite keeps remote commands alive after the link drops, so nothing
    # tears us down for free. Silence means the operator is gone: exit, which
    # closes every proxied connection and frees the port.
    while True:
        time.sleep(2)
        if time.time() - last[0] > IDLE:
            sys.stderr.write("relay: %.0fs silent, exiting\n" % IDLE)
            os._exit(0)


def readexact(n):
    buf = b""
    while len(buf) < n:
        c = inp.read(n - len(buf))
        if not c:
            return None
        buf += c
    return buf


threading.Thread(target=chan_writer, daemon=True).start()
threading.Thread(target=acceptor, daemon=True).start()
threading.Thread(target=watchdog, daemon=True).start()

while True:
    h = readexact(HDR.size)
    if h is None:
        break
    sid, t, ln = HDR.unpack(h)
    payload = readexact(ln) if ln else b""
    if payload is None:
        break
    last[0] = time.time()
    if t == T_PING:
        continue
    with slock:
        st = streams.get(sid)
    if st is None:
        continue
    if t == T_DATA:
        if not st.feed(payload):
            # Buffered past MAX_BUF: this consumer is not coming back. Drop
            # it alone rather than letting it hold up the demultiplexer.
            with slock:
                streams.pop(sid, None)
            send(sid, T_CLOSE)
            st.close()
    elif t == T_CLOSE:
        with slock:
            streams.pop(sid, None)
        st.close()
os._exit(0)
'''


# --------------------------------------------------------------------------
# this side of the mux
# --------------------------------------------------------------------------

class Stream(object):
    """A proxied socket plus its own writer thread.

    The frame reader must never block on one of these. With a single `claude`
    on the sprite a blocking write is just backpressure, but with several,
    one that stops draining would stall every other stream -- and since the
    reader is also what refreshes the relay's idle timestamp, the watchdog
    would then tear the whole session down 30s later.
    """

    def __init__(self, conn):
        self.conn = conn
        self.q = queue.Queue()
        self.buffered = 0
        self.lock = threading.Lock()
        self.closed = False
        threading.Thread(target=self._writer, daemon=True).start()

    def feed(self, data):
        """Hand off without blocking. False means the peer is not draining."""
        with self.lock:
            if self.closed:
                return False
            if self.buffered + len(data) > MAX_STREAM_BUFFER:
                return False
            self.buffered += len(data)
        self.q.put(data)
        return True

    def _writer(self):
        while True:
            data = self.q.get()
            if data is None:
                break
            try:
                self.conn.sendall(data)
            except OSError:
                break
            with self.lock:
                self.buffered -= len(data)
        self.close()

    def close(self):
        with self.lock:
            if self.closed:
                return
            self.closed = True
        self.q.put(None)
        _drop(self.conn)


class Mux(object):
    """Demultiplexes the sprite's framed stdout into local proxy connections."""

    def __init__(self, proc, proxy_port, verbose):
        self.proc = proc
        self.proxy_port = proxy_port
        self.verbose = verbose
        self.socks = {}
        self.lock = threading.Lock()
        self.alive = True
        self.ready = threading.Event()
        # Bounded, drained by one writer thread. Producers are per-stream
        # pump threads, so blocking one when the pipe backs up is that
        # stream's backpressure -- not a lock every other stream waits on.
        self.outq = queue.Queue(maxsize=256)
        threading.Thread(target=self._chan_writer, daemon=True).start()

    def send(self, sid, t, payload=b""):
        try:
            self.outq.put(HDR.pack(sid, t, len(payload)) + payload)
        except Exception:
            self.alive = False

    def _chan_writer(self):
        while True:
            buf = self.outq.get()
            if buf is None:
                break
            try:
                self.proc.stdin.write(buf)
                self.proc.stdin.flush()
            except (OSError, ValueError):
                self.alive = False
                break

    def _pump(self, sid, st):
        try:
            while True:
                b = st.conn.recv(65536)
                if not b:
                    break
                self.send(sid, T_DATA, b)
        except OSError:
            pass
        finally:
            with self.lock:
                self.socks.pop(sid, None)
            self.send(sid, T_CLOSE)
            st.close()

    def _open(self, sid):
        with self.lock:
            if len(self.socks) >= MAX_STREAMS:
                log("refusing stream %d: %d already open" % (sid, MAX_STREAMS))
                self.send(sid, T_CLOSE)
                return
            stale = self.socks.pop(sid, None)
        if stale is not None:
            # A repeated SID used to overwrite the entry and leak the socket.
            stale.close()
        try:
            conn = socket.create_connection(("127.0.0.1", self.proxy_port), timeout=10)
            conn.settimeout(None)
        except OSError as e:
            log("could not reach local proxy: %r" % (e,))
            self.send(sid, T_CLOSE)
            return
        st = Stream(conn)
        with self.lock:
            self.socks[sid] = st
        threading.Thread(target=self._pump, args=(sid, st), daemon=True).start()

    def pinger(self):
        while self.alive:
            time.sleep(PING_EVERY)
            self.send(0, T_PING)

    def _readexact(self, n):
        # Chunks into a list rather than repeatedly concatenating: `buf += c`
        # over a large frame is quadratic.
        parts, got = [], 0
        while got < n:
            c = self.proc.stdout.read(n - got)
            if not c:
                return None
            parts.append(c)
            got += len(c)
        return b"".join(parts)

    def run(self):
        threading.Thread(target=self.pinger, daemon=True).start()
        while True:
            h = self._readexact(HDR.size)
            if h is None:
                break
            sid, t, ln = HDR.unpack(h)
            if ln > MAX_FRAME:
                # The length is a uint32 chosen by the far end. Allocating on
                # its say-so is how the sprite OOMs this machine; the relay
                # never legitimately sends more than 64KB.
                log("frame of %d bytes exceeds the %d byte limit -- "
                    "closing the link" % (ln, MAX_FRAME))
                break
            payload = self._readexact(ln) if ln else b""
            if payload is None:
                break
            self.ready.set()
            if t == T_OPEN:
                self._open(sid)
            elif t == T_DATA:
                with self.lock:
                    st = self.socks.get(sid)
                if st is not None and not st.feed(payload):
                    log("stream %d buffered past %d bytes without draining -- "
                        "dropping it" % (sid, MAX_STREAM_BUFFER))
                    with self.lock:
                        self.socks.pop(sid, None)
                    self.send(sid, T_CLOSE)
                    st.close()
            elif t == T_CLOSE:
                with self.lock:
                    st = self.socks.pop(sid, None)
                if st is not None:
                    st.close()
        self.alive = False
        self.ready.set()


# --------------------------------------------------------------------------
# sprite plumbing
# --------------------------------------------------------------------------

def resolve_sprite(name):
    """`sprite` takes its target from -s or from a .sprite file in the current
    directory -- there is no other default. Establish that here rather than
    discovering it as an ssh failure after the credential is already loaded."""
    if name:
        return name
    if os.path.exists(".sprite"):
        return ""  # the sprite CLI reads it, exactly as it would anyway
    die("no sprite selected.",
        "  imp -s NAME",
        "or run `sprite use NAME` in this directory first.")


def wait_for_link(mux, proc, timeout):
    """The relay pings as soon as it is listening; that frame is the only
    honest signal that the sprite side exists."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if mux.ready.wait(0.25):
            return mux.alive
        if proc.poll() is not None:
            return False
    return False


def wait_for_marker(proc, timeout):
    """Same question for a native -R forward, same answer: wait to be told.

    ssh returning success only means it connected. The marker is printed by
    the remote shell, which does not run until the forward has been set up --
    and with ExitOnForwardFailure, not at all if it could not be.
    """
    ready = threading.Event()

    def reader():
        for line in iter(proc.stdout.readline, b""):
            if line.strip() == LINK_MARKER.encode():
                ready.set()
                return

    threading.Thread(target=reader, daemon=True).start()
    deadline = time.time() + timeout
    while time.time() < deadline:
        if ready.wait(0.25):
            return True
        if proc.poll() is not None:
            return False
    return False


# A shared ControlMaster would outlive revocation -- the whole point is that
# stopping this process ends the far side's access, and a multiplexed socket
# someone else is holding open does not end.
SSH_COMMON = [
    "-o", "ControlMaster=no",
    "-o", "ControlPath=none",
    "-o", "ServerAliveInterval=10",
    "-o", "ServerAliveCountMax=3",
]

# Printed by the far side once its end of the forward exists, which is the
# only honest signal that it does. POSIX sh, no python: with a real -R there
# is nothing else the remote has to be able to run.
LINK_MARKER = "IMP_LINK_UP"
LINK_CMD = "echo %s; exec cat >/dev/null" % LINK_MARKER


class SpriteTarget(object):
    """A Fly Sprite, reached through the sprite CLI.

    `sprite proxy --ssh` supports neither -R nor -A, so the reverse forward
    has to be the userspace relay in RELAY_SRC. Host key checking is off
    because the ProxyCommand builds a fresh transport per connection -- there
    is no stable key to pin, and the CLI has already authenticated it.
    """

    needs_relay = True

    def __init__(self, name):
        self.name = name

    def label(self):
        return self.name or "(from .sprite)"

    def exec_argv(self, remote_cmd):
        proxy_cmd = "sprite proxy --ssh"
        if self.name:
            proxy_cmd += " -s " + self.name
        return [
            "ssh",
            "-o", "ProxyCommand=" + proxy_cmd,
            "-o", "StrictHostKeyChecking=no",
            "-o", "UserKnownHostsFile=/dev/null",
            "-o", "LogLevel=ERROR",
        ] + SSH_COMMON + ["sprite", remote_cmd]

    def link_argv(self, remote_port, local_port):
        return self.exec_argv(remote_python(
            RELAY_SRC, (str(remote_port), str(RELAY_IDLE_TIMEOUT))))


class SSHTarget(object):
    """Any host that speaks ordinary ssh, where -R does natively what the
    relay was written to work around.

    Host key checking is left alone here. The sprite's is a throwaway
    transport; a machine you own is not, and turning off the check for it
    would be trading a real protection for nothing.
    """

    needs_relay = False

    def __init__(self, dest):
        self.dest = dest

    def label(self):
        return self.dest

    def exec_argv(self, remote_cmd):
        return ["ssh"] + SSH_COMMON + [self.dest, remote_cmd]

    def link_argv(self, remote_port, local_port):
        # 127.0.0.1 spelled out on both ends. `-R 8080:...` binds 0.0.0.0 on
        # a host configured with GatewayPorts yes, which would put the
        # capability endpoint on the network -- the one way this transport
        # can be less careful than the relay, which only ever binds loopback.
        fwd = "127.0.0.1:%d:127.0.0.1:%d" % (remote_port, local_port)
        # Without ExitOnForwardFailure a taken remote port is a warning and a
        # session that silently has no proxy behind it. The relay reports the
        # same condition by failing to bind and never pinging.
        return ["ssh", "-R", fwd,
                "-o", "ExitOnForwardFailure=yes"] + SSH_COMMON + [
                self.dest, LINK_CMD]


# Compare-and-swap on the capability, which is already unique per session.
# Without it, a second imp against the same sprite (only possible with -p,
# since the relay's bind on the default port already refuses a collision)
# silently repoints settings.json at itself, and whichever session exits
# first strips the env block out from under the other.
#
# A capability that is not ours is only worth respecting if the session
# behind it still exists, and this script runs on the sprite -- where that
# question is answerable by connecting to the port the pointer names. A
# crashed session leaves an inert pointer and nothing listening, so it is
# taken over silently rather than blocking every future run.
SETTINGS_SCRIPT = r'''
import json, os, socket, sys, tempfile

base_url = sys.stdin.readline().strip()
capability = sys.stdin.readline().strip()
# Clearing normally removes only our own pointer. --clear passes force, which
# is the escape hatch for one nothing is behind.
force = sys.stdin.readline().strip() == "force"


def holder_is_live(url):
    """Is anything actually listening on the port this pointer names?"""
    try:
        port = int(url.rsplit(":", 1)[-1])
    except (ValueError, AttributeError):
        return False          # not a pointer imp wrote; nothing to protect
    s = socket.socket()
    s.settimeout(0.5)
    try:
        s.connect(("127.0.0.1", port))
        return True
    except OSError:
        return False
    finally:
        s.close()

path = os.path.expanduser("~/.claude/settings.json")
try:
    with open(path) as f:
        data = json.load(f)
except (IOError, OSError):
    data = {}
except ValueError:
    sys.exit("existing settings.json is not valid JSON; refusing to touch it")

env = data.setdefault("env", {})
held = env.get("ANTHROPIC_AUTH_TOKEN")
warn = ""
if "CLAUDE_CODE_OAUTH_TOKEN" in env:
    warn = "WARNING: a stored CLAUDE_CODE_OAUTH_TOKEN is present in settings.json"

if base_url:
    if held and held != capability:
        held_url = env.get("ANTHROPIC_BASE_URL")
        if holder_is_live(held_url):
            sys.exit("BUSY: another imp session is live on %s. Stop it first."
                     % held_url)
        warn = (warn + " | " if warn else "") + "took over a dead session's pointer"
    env["ANTHROPIC_BASE_URL"] = base_url
    env["ANTHROPIC_AUTH_TOKEN"] = capability
else:
    if held is None:
        warn = (warn + " | " if warn else "") + "no pointer was set"
    elif held != capability and not force:
        # Another session took over while we were running. Its pointer is
        # live and ours is already gone; removing it would break them.
        print("left another session's capability in place")
        sys.exit(0)
    elif held != capability:
        # Say what was taken and whether anything is behind it, because the
        # answer decides whether there is a session somewhere to go and stop.
        note = ("something is STILL listening on it"
                if holder_is_live(env.get("ANTHROPIC_BASE_URL"))
                else "nothing was listening on it")
        warn = (warn + " | " if warn else "") + (
            "cleared a pointer we did not own (%s...); %s" % (held[:8], note))
    env.pop("ANTHROPIC_BASE_URL", None)
    env.pop("ANTHROPIC_AUTH_TOKEN", None)
    if not env:
        data.pop("env", None)

d = os.path.dirname(path)
os.makedirs(d, exist_ok=True)
# A unique temp name: two writers sharing a fixed one interleave, and each
# os.replace is atomic only with respect to its own content.
fd, tmp = tempfile.mkstemp(prefix=".imp.", suffix=".tmp", dir=d)
try:
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
except BaseException:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
print("ok" + ((" | " + warn) if warn else ""))
'''


def remote_python(src, args=()):
    b64 = base64.b64encode(src.encode()).decode()
    argv = " ".join("'%s'" % a for a in args)
    return ("python3 -u -c \"exec(__import__('base64').b64decode('%s'))\" %s"
            % (b64, argv))


def write_remote_settings(target, base_url, capability, force=False):
    """Install (or clear) the far side's pointer at us. Neither value is a
    secret.

    Installing refuses to displace another session's capability while that
    session is still listening; clearing only ever removes our own.
    """
    argv = target.exec_argv(remote_python(SETTINGS_SCRIPT))
    try:
        r = subprocess.run(argv,
                           input="%s\n%s\n%s\n" % (base_url, capability,
                                                    "force" if force else ""),
                           capture_output=True, text=True,
                           timeout=SETTINGS_TIMEOUT)
    except subprocess.TimeoutExpired:
        # The far side controls when this command finishes and how much
        # it prints. Teardown must not be something it can hold open.
        return False, "timed out after %.0fs" % SETTINGS_TIMEOUT
    if r.returncode != 0:
        return False, (r.stderr.strip() or "ssh failed")
    return True, r.stdout.strip()


def clear_target(target):
    """Force-remove the far side's pointer, whoever wrote it.

    There is nothing running on the far side to kill -- an imp session is a
    process on somebody's machine plus a line in a settings.json -- so this
    removes the line and reports whether anything is still answering behind
    it. Something listening means a session really is live, on a machine that
    is not necessarily this one; nothing listening means the pointer was the
    whole of it.
    """
    ok, msg = write_remote_settings(target, "", "", force=True)
    if not ok:
        log("could not clear %s: %s" % (target.label(), msg))
        return 1
    # The script reports through the same "ok | note" line every other call
    # uses; for a clear, the note is the whole of the news.
    log("%s: %s" % (target.label(),
                    msg[5:] if msg.startswith("ok | ") else "cleared"))
    return 0


# --------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        prog="imp-proxy",
        description="Lend a sprite -- or any host you can ssh to -- your Claude "
                    "Max subscription without giving it the credential.",
        epilog="The credential never leaves this machine. Stop the proxy "
               "(Ctrl-C) and the far side's access dies immediately -- running "
               "`claude` processes there simply start failing API calls, so "
               "revoking costs you nothing but a reconnect.")
    ap.add_argument("-s", "--sprite", default="",
                    help="sprite name (default: the one `sprite use` selected "
                         "in this directory)")
    ap.add_argument("-H", "--host", default="",
                    help="an ssh destination instead of a sprite -- anything "
                         "`ssh` accepts, including a Host from your ssh config")
    ap.add_argument("-p", "--remote-port", type=int, default=8080,
                    help="port to listen on at the far end (default 8080)")
    ap.add_argument("--no-settings", action="store_true",
                    help="do not touch the far side's ~/.claude/settings.json; "
                         "print the env vars for you to set yourself")
    ap.add_argument("--allow", action="append", default=[], metavar="GLOB",
                    help="allow an extra request path through; repeatable, "
                         "globs accepted")
    ap.add_argument("--allow-any-path", action="store_true",
                    help="disable the path allowlist entirely -- the proxy "
                         "becomes an open relay to your account for the "
                         "length of the session")
    ap.add_argument("--clear", action="store_true",
                    help="remove the far side's ANTHROPIC_* pointer, whoever "
                         "left it, and say whether anything is still behind "
                         "it. The way out of a pointer with nothing running "
                         "under it; starts no proxy and reads no credential")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="log each proxied request")
    args = ap.parse_args()
    if args.host and args.sprite:
        die("-s and -H name two different machines; pick one.")
    if args.host:
        target = SSHTarget(args.host)
    else:
        target = SpriteTarget(resolve_sprite(args.sprite))

    if args.clear:
        return clear_target(target)

    cred = Credential()
    capability = base64.urlsafe_b64encode(os.urandom(24)).decode().rstrip("=")
    log("credential loaded (%d chars) from %s" % (len(cred.token), cred.source))

    allowed = () if args.allow_any_path else DEFAULT_ALLOWED + tuple(args.allow)
    if allowed:
        log("path allowlist: %s" % " ".join(allowed))
    else:
        log("path allowlist DISABLED -- any path reaches your account")

    handler = make_proxy_handler(cred, capability, args.verbose, allowed)
    proxy = ProxyServer(("127.0.0.1", 0), handler)
    proxy_port = proxy.server_address[1]
    threading.Thread(target=proxy.serve_forever, daemon=True).start()
    log("injecting proxy on 127.0.0.1:%d (loopback only)" % proxy_port)

    base_url = "http://127.0.0.1:%d" % args.remote_port

    # Ownership is settled before the link exists, and the ordering is the
    # whole of the check. Once our own forward is listening on the far side's
    # port, holder_is_live() connects to it and reports *us* as the incumbent
    # -- so a pointer left behind by a killed session would refuse every
    # future run, permanently, with nothing there to go and stop.
    settings_written = False
    if not args.no_settings:
        ok, msg = write_remote_settings(target, base_url, capability)
        if ok:
            settings_written = True
            log("remote settings.json points at us (%s)" % msg)
        elif "BUSY:" in msg:
            # Another live session owns the far side. Breaking it is never the
            # right default -- stop here rather than half-taking-over.
            log(msg.replace("BUSY: ", ""))
            log("if nothing is really running there: imp-proxy --clear")
            proxy.shutdown()
            return 1
        else:
            log("could not write remote settings.json: %s" % msg)
            log("set these on the far side yourself:")
            log("  ANTHROPIC_BASE_URL=%s" % base_url)
            log("  ANTHROPIC_AUTH_TOKEN=%s" % capability)
    else:
        log("set these on the far side yourself:")
        log("  ANTHROPIC_BASE_URL=%s" % base_url)
        log("  ANTHROPIC_AUTH_TOKEN=%s" % capability)

    proc = subprocess.Popen(target.link_argv(args.remote_port, proxy_port),
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=None, bufsize=0)

    def on_signal(signum, frame):
        try:
            proc.terminate()
        except OSError:
            pass

    # SIGHUP too, and not for tidiness: Python's default for it kills the
    # process outright, so the teardown below -- the one that clears the
    # sprite's settings.json -- never runs. A terminal closing or a tmux pane
    # being destroyed both arrive that way, which makes the ordinary way to
    # end a session the one path that skips cleanup.
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, on_signal)

    # The sprite gets the userspace relay and its demultiplexer; a plain ssh
    # host gets -R, where the kernel on both ends is the demultiplexer and
    # there is nothing here to run.
    mux = None
    if target.needs_relay:
        mux = Mux(proc, proxy_port, args.verbose)
        threading.Thread(target=mux.run, daemon=True).start()
        linked = wait_for_link(mux, proc, LINK_TIMEOUT)
    else:
        linked = wait_for_marker(proc, LINK_TIMEOUT)
    if not linked:
        log("no link to '%s' -- it failed or timed out." % target.label())
        if target.needs_relay:
            log("check `sprite ls` and that python3 exists on the sprite.")
        else:
            log("check `ssh %s true`, and that port %d is free there."
                % (target.label(), args.remote_port))
        try:
            proc.terminate()
        except OSError:
            pass
        # The pointer went in before the link was tried, so a link that never
        # came up leaves one to take back out.
        if settings_written:
            write_remote_settings(target, "", capability)
        proxy.shutdown()
        return 1

    log("ready -- `claude` on %s now runs on your Max subscription."
        % target.label())
    log("Ctrl-C revokes instantly. Nothing to clean up there.")

    try:
        while proc.poll() is None and (mux is None or mux.alive):
            time.sleep(0.25)
    finally:
        log("link closed -- access revoked")
        try:
            proc.terminate()
        except OSError:
            pass
        if settings_written:
            ok, msg = write_remote_settings(target, "", capability)
            log("cleared remote settings.json" if ok
                else "left an inert capability in settings.json (%s)" % msg)
        proxy.shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
