#!/bin/bash
# imp — get a sprite console with imp-proxy already running beside it.
#
# Sugar, nothing more. These are two commands you could type yourself:
#
#     imp-proxy -s NAME          # lend the sprite your subscription
#     sprite console -s NAME     # get a shell on it
#
# You would type the sprite name twice and juggle two terminals. This types it
# once and puts them in one tmux window -- console on top, the proxy's log in
# a strip along the bottom where you can see `ready`, `rejected:` and the rest
# of what it has to say.
#
# Everything of consequence stays in imp-proxy: the credential, the path
# allowlist, the capability. This script never touches any of them, and it
# deliberately validates nothing imp-proxy validates -- no sprite selected is
# imp-proxy's error to report, in the words it already uses.
#
# tmux is not required. Without it this is exactly `imp-proxy`, and you open a
# console wherever you like.

set -euo pipefail

die() { printf 'imp: %s\n' "$*" >&2; exit 1; }

usage() {
  cat >&2 <<'USAGE'
usage: imp [-s NAME] [imp-proxy options...]

Opens a tmux window: `sprite console` above, `imp-proxy` below. Every option
is passed through to imp-proxy untouched -- see `imp-proxy --help`.

Ctrl-C in the lower pane revokes the sprite's access, exactly as it always
has. So does closing the window.
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

# imp-proxy from this checkout before one on PATH. You will at some point be
# testing a modified proxy while a released one is installed, and picking the
# wrong one is a confusing afternoon.
here=$(cd -- "$(dirname -- "$0")" && pwd)
proxy="$here/imp-proxy"
[ -x "$proxy" ] || proxy=imp-proxy

# The name is wanted for one thing -- labelling the tmux window -- so a
# failure to find it is not an error here. imp-proxy resolves it for real.
sprite=""
prev=""
for arg in "$@"; do
  case "$prev" in -s|--sprite) sprite="$arg"; break ;; esac
  prev="$arg"
done
if [ -z "$sprite" ] && [ -r .sprite ]; then
  read -r sprite < .sprite || sprite=""
fi
[ -n "$sprite" ] || sprite="sprite"
label=${sprite//[^A-Za-z0-9_-]/-}

if ! command -v tmux >/dev/null 2>&1; then
  printf 'imp: no tmux -- running the proxy here.\n' >&2
  printf 'imp: open a console with `sprite console` in another terminal.\n' >&2
  exec "$proxy" "$@"
fi

# tmux wants one command string, so the passthrough has to survive being
# re-parsed by a shell. printf %q is what makes that safe rather than hopeful.
cmd=$(printf '%q' "$proxy")
for arg in "$@"; do
  cmd="$cmd $(printf '%q' "$arg")"
done

if [ -n "${TMUX:-}" ]; then
  win=$(tmux new-window -P -F '#{window_id}' -n "imp:$label" "sprite console")
  attach=""
else
  session="imp-$label"
  if ! win=$(tmux new-session -d -s "$session" -P -F '#{window_id}' \
             -n "imp:$label" "sprite console" 2>/dev/null); then
    die "tmux session '$session' already exists -- \`tmux attach -t $session\`"
  fi
  attach="$session"
fi

# -d keeps the cursor in the console; the proxy is there to be read, not typed
# into. Eight lines is its whole startup banner with nothing scrolled off.
pane=$(tmux split-window -v -l 8 -d -t "$win" -P -F '#{pane_id}' "$cmd")

# So a proxy that dies leaves its reason on screen instead of the pane
# vanishing. Pane options are tmux 3.0+; on older tmux this is merely absent.
tmux set-option -p -t "$pane" remain-on-exit on 2>/dev/null || true

[ -z "$attach" ] || exec tmux attach -t "$attach"
