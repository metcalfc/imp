#!/usr/bin/env python3
"""imp — lend a sprite your Claude Max subscription without ever giving
it the credential.

The token stays on this machine. A local proxy holds it and injects it into
every request; the sprite gets only a per-session capability string and a URL
that resolves to this machine's loopback. Stop the proxy and the sprite's
access dies instantly — no watchdog, no teardown, nothing to scrub, and no
need to kill running `claude` processes to revoke.

The sprite cannot reach us directly: `sprite proxy --ssh` supports neither -R
nor -A. So we reimplement remote forwarding in userspace over the one ssh
stdio channel, which is 8-bit clean in both directions (verified).

    this machine                         sprite
    ------------------------------------------------------------
    injecting proxy  <--+            +--> claude
      (real token)      |            |    ANTHROPIC_BASE_URL=
                        |            |    http://127.0.0.1:8080
                  demux |            | relay listens :8080
                        +-- ssh stdio +
                            (framed, multiplexed)

Runs on macOS and Linux. Requires only python3 and the `sprite` CLI here, and
python3 on the sprite.
"""

import argparse
import base64
import json
import os
import fnmatch
import platform
import posixpath
import signal
import socket
import socketserver
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

UPSTREAM = "https://api.anthropic.com"

# Claude Code drops oauth-2025-04-20 from its beta list when it has no local
# OAuth credentials -- which is exactly the state the sprite is in. Without it
# the Max entitlement is not honoured, so we put it back on the way out.
REQUIRED_BETAS = ("claude-code-20250219", "oauth-2025-04-20")

# A hostile sprite gets to choose the request path, so the proxy is otherwise an
# open relay to your account for the length of the session. Only inference
# endpoints are worth reaching through here; everything else is refused before
# the credential is ever attached. Extend with --allow, escape with
# --allow-any-path.
DEFAULT_ALLOWED = (
    "/v1/messages",
    "/v1/messages/count_tokens",
    "/v1/models",
    "/v1/models/*",
)

HDR = struct.Struct("!IBI")
T_OPEN, T_DATA, T_CLOSE, T_PING = 1, 2, 3, 4

PING_EVERY = 10.0
LINK_TIMEOUT = 60.0
RELAY_IDLE_TIMEOUT = 30.0


def log(*a):
    sys.stderr.write("[imp] " + " ".join(str(x) for x in a) + "\n")
    sys.stderr.flush()


def die(*lines):
    for line in lines:
        log(line)
    raise SystemExit(2)


# --------------------------------------------------------------------------
# credential lookup (macOS + Linux)
# --------------------------------------------------------------------------

def _run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        return None


def _extract_token(blob):
    """A credential blob is either a bare token or JSON holding accessToken."""
    blob = blob.strip()
    if not blob:
        return None
    try:
        data = json.loads(blob)
    except ValueError:
        return blob

    found = []

    def walk(o):
        if isinstance(o, dict):
            for k, v in o.items():
                if k == "accessToken" and isinstance(v, str):
                    found.append(v)
                else:
                    walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    walk(data)
    return found[0] if found else None


def load_credential():
    """Return (token, human-readable source). Never logged, never written out.

    Preferred: the dedicated setup-token minted by imp-auth, which is
    long-lived and inference-only. Falls back to this machine's live Claude
    login, which works but carries a short-lived access token -- see --help.
    """
    darwin = platform.system() == "Darwin"
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or ""

    if darwin:
        candidates = [
            (["security", "find-generic-password", "-s", "imp-oauth",
              "-a", user, "-w"], "macOS keychain (imp-oauth, setup-token)"),
            (["security", "find-generic-password", "-s", "Claude Code-credentials",
              "-a", user, "-w"], "macOS keychain (live Claude login)"),
        ]
        for cmd, source in candidates:
            r = _run(cmd)
            if r is not None and r.returncode == 0:
                tok = _extract_token(r.stdout)
                if tok:
                    return tok, source
    else:
        path = os.path.expanduser("~/.claude/.credentials.json")
        if os.path.exists(path):
            with open(path) as f:
                tok = _extract_token(f.read())
            if tok:
                return tok, path
        for service in ("imp-oauth", "Claude Code-credentials"):
            r = _run(["secret-tool", "lookup", "service", service])
            if r is not None and r.returncode == 0:
                tok = _extract_token(r.stdout)
                if tok:
                    return tok, "secret-tool (%s)" % service

    env = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")
    if env:
        return env.strip(), "CLAUDE_CODE_OAUTH_TOKEN in this environment"

    raise SystemExit(
        "no Claude credential found.\n"
        "  Mint a dedicated one:  claude setup-token   (then store it as\n"
        "  'imp-oauth' in your keychain), or just log in with `claude`."
    )


# --------------------------------------------------------------------------
# the injecting proxy — the only thing that ever sees the real token
# --------------------------------------------------------------------------

def normalize_path(raw):
    """Path component of a request target, or None if it is not safe to use.

    Rejects anything that is not an absolute path, and anything whose normal
    form differs from what was sent -- traversal like /v1/messages/../../x
    would otherwise smuggle a request past a prefix check.
    """
    if not raw.startswith("/"):
        return None
    path = raw.split("#", 1)[0].split("?", 1)[0]
    if "\\" in path:
        return None
    norm = posixpath.normpath(path)
    if norm != path and norm != path.rstrip("/"):
        return None
    return norm


def path_allowed(path, patterns):
    if not patterns:            # --allow-any-path
        return True
    return any(fnmatch.fnmatchcase(path, pat) for pat in patterns)


HOP = {"host", "accept-encoding", "content-length", "connection", "keep-alive",
       "proxy-authenticate", "proxy-authorization", "te", "trailers",
       "transfer-encoding", "upgrade"}


def _close(resp):
    """Release an upstream response -- an HTTPError body holds a socket too."""
    try:
        resp.close()
    except Exception:
        pass


class Credential(object):
    """Holds the live token. Re-read on a 401 so a long session survives the
    access token rolling underneath it -- Claude Code on this machine refreshes
    the keychain entry, we just notice."""

    def __init__(self):
        self.token, self.source = load_credential()
        self.lock = threading.Lock()

    def refresh(self):
        with self.lock:
            old = self.token
            try:
                self.token, self.source = load_credential()
            except SystemExit as e:
                log("credential refresh failed: %s" % e)
                return False
            return self.token != old


def make_proxy_handler(cred, capability, verbose, allowed):
    import http.server

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *args):
            pass

        def _reject(self, code, why):
            log("rejected: %s" % why)
            body = json.dumps({"type": "error", "error": {
                "type": "authentication_error", "message": why}}).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _proxy(self):
            path = normalize_path(self.path)
            if path is None:
                self._reject(400, "malformed request path")
                return
            if not path_allowed(path, allowed):
                self._reject(403, "path %s is not on the allowlist" % path)
                return

            body = b""
            n = self.headers.get("Content-Length")
            if n:
                body = self.rfile.read(int(n))

            fwd = {k: v for k, v in self.headers.items() if k.lower() not in HOP}
            fwd["Accept-Encoding"] = "identity"

            # Strip *every* credential header the sprite sent, not just the
            # first -- `presented or fwd.pop(k)` would short-circuit and
            # forward a second one upstream alongside the real token.
            presented = ""
            for k in list(fwd):
                if k.lower() in ("authorization", "x-api-key"):
                    v = fwd.pop(k)
                    presented = presented or v
            presented = presented[7:] if presented.lower().startswith("bearer ") else presented

            if not presented or presented.strip() != capability:
                self._reject(403, "bad or missing session capability")
                return

            fwd["Authorization"] = "Bearer " + cred.token
            betas = [b for b in (fwd.get("anthropic-beta") or "").split(",") if b]
            for b in REQUIRED_BETAS:
                if b not in betas:
                    betas.insert(0, b)
            if betas:
                fwd["anthropic-beta"] = ",".join(betas)

            if verbose:
                log("%s %s (%d bytes up)" % (self.command, self.path, len(body)))

            def attempt():
                req = urllib.request.Request(UPSTREAM + self.path, data=body or None,
                                             headers=fwd, method=self.command)
                try:
                    r = urllib.request.urlopen(req, timeout=600)
                    return r, r.getcode(), None
                except urllib.error.HTTPError as e:
                    return e, e.code, None
                except Exception as e:
                    return None, None, e

            resp, code, err = attempt()
            if code == 401 and cred.refresh():
                log("upstream 401 -- reloaded credential, retrying")
                _close(resp)          # the 401 body still owns a socket
                fwd["Authorization"] = "Bearer " + cred.token
                resp, code, err = attempt()
            if err is not None:
                log("upstream error: %r" % (err,))
                self._reject(502, "upstream error")
                return

            self.send_response(code)
            for k, v in resp.headers.items():
                if k.lower() not in HOP:
                    self.send_header(k, v)
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()

            # Streamed verbatim so SSE arrives token-by-token, not buffered.
            try:
                while True:
                    chunk = resp.read(4096)
                    if not chunk:
                        break
                    self.wfile.write(b"%x\r\n" % len(chunk) + chunk + b"\r\n")
                    self.wfile.flush()
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()
            finally:
                _close(resp)

        do_GET = do_POST = do_PUT = do_DELETE = _proxy

    return Handler


class ProxyServer(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request, client_address):
        """A client hanging up mid-request is routine -- `claude` does it on
        every Ctrl-C. socketserver's default would dump a traceback for it.
        Anything genuinely unexpected gets one line, never headers or bodies."""
        exc = sys.exc_info()[1]
        if isinstance(exc, (ConnectionResetError, BrokenPipeError,
                            ConnectionAbortedError, socket.timeout)):
            return
        log("connection error: %r" % (exc,))


# --------------------------------------------------------------------------
# the relay that runs on the sprite (shipped as base64 in argv, never a file)
# --------------------------------------------------------------------------

RELAY_SRC = r'''
import os, socket, struct, sys, threading, time

PORT = int(sys.argv[1])
IDLE = float(sys.argv[2])
HDR = struct.Struct("!IBI")
T_OPEN, T_DATA, T_CLOSE, T_PING = 1, 2, 3, 4

out = sys.stdout.buffer
inp = sys.stdin.buffer
outlock = threading.Lock()
streams = {}
slock = threading.Lock()
last = [time.time()]


def send(sid, t, payload=b""):
    with outlock:
        try:
            out.write(HDR.pack(sid, t, len(payload)))
            if payload:
                out.write(payload)
            out.flush()
        except (OSError, ValueError):
            os._exit(0)


def pump(sid, conn):
    try:
        while True:
            b = conn.recv(65536)
            if not b:
                break
            send(sid, T_DATA, b)
    except OSError:
        pass
    finally:
        with slock:
            streams.pop(sid, None)
        send(sid, T_CLOSE)
        try:
            conn.close()
        except OSError:
            pass


def acceptor():
    srv = socket.socket()
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind(("127.0.0.1", PORT))
    except OSError as e:
        sys.stderr.write("relay: cannot bind 127.0.0.1:%d: %s\n" % (PORT, e))
        sys.stderr.flush()
        os._exit(1)
    srv.listen(64)
    sys.stderr.write("relay listening on 127.0.0.1:%d\n" % PORT)
    sys.stderr.flush()
    # Tell the other end the link is genuinely up. Nothing is "ready" before
    # this frame arrives.
    send(0, T_PING)
    n = 0
    while True:
        conn, _ = srv.accept()
        n += 1
        with slock:
            streams[n] = conn
        send(n, T_OPEN)
        threading.Thread(target=pump, args=(n, conn), daemon=True).start()


def watchdog():
    # The sprite keeps remote commands alive after the link drops, so nothing
    # tears us down for free. Silence means the operator is gone: exit, which
    # closes every proxied connection and frees the port.
    while True:
        time.sleep(2)
        if time.time() - last[0] > IDLE:
            sys.stderr.write("relay: %.0fs silent, exiting\n" % IDLE)
            os._exit(0)


def readexact(n):
    buf = b""
    while len(buf) < n:
        c = inp.read(n - len(buf))
        if not c:
            return None
        buf += c
    return buf


threading.Thread(target=acceptor, daemon=True).start()
threading.Thread(target=watchdog, daemon=True).start()

while True:
    h = readexact(HDR.size)
    if h is None:
        break
    sid, t, ln = HDR.unpack(h)
    payload = readexact(ln) if ln else b""
    if payload is None:
        break
    last[0] = time.time()
    if t == T_PING:
        continue
    with slock:
        conn = streams.get(sid)
    if conn is None:
        continue
    if t == T_DATA:
        try:
            conn.sendall(payload)
        except OSError:
            with slock:
                streams.pop(sid, None)
            try:
                conn.close()
            except OSError:
                pass
    elif t == T_CLOSE:
        with slock:
            streams.pop(sid, None)
        try:
            conn.close()
        except OSError:
            pass
os._exit(0)
'''


# --------------------------------------------------------------------------
# this side of the mux
# --------------------------------------------------------------------------

class Mux(object):
    """Demultiplexes the sprite's framed stdout into local proxy connections."""

    def __init__(self, proc, proxy_port, verbose):
        self.proc = proc
        self.proxy_port = proxy_port
        self.verbose = verbose
        self.socks = {}
        self.lock = threading.Lock()
        self.wlock = threading.Lock()
        self.alive = True
        self.ready = threading.Event()

    def send(self, sid, t, payload=b""):
        with self.wlock:
            try:
                self.proc.stdin.write(HDR.pack(sid, t, len(payload)))
                if payload:
                    self.proc.stdin.write(payload)
                self.proc.stdin.flush()
            except (OSError, ValueError):
                self.alive = False

    def _pump(self, sid, conn):
        try:
            while True:
                b = conn.recv(65536)
                if not b:
                    break
                self.send(sid, T_DATA, b)
        except OSError:
            pass
        finally:
            with self.lock:
                self.socks.pop(sid, None)
            self.send(sid, T_CLOSE)
            try:
                conn.close()
            except OSError:
                pass

    def _open(self, sid):
        try:
            conn = socket.create_connection(("127.0.0.1", self.proxy_port), timeout=10)
            conn.settimeout(None)
        except OSError as e:
            log("could not reach local proxy: %r" % (e,))
            self.send(sid, T_CLOSE)
            return
        with self.lock:
            self.socks[sid] = conn
        threading.Thread(target=self._pump, args=(sid, conn), daemon=True).start()

    def pinger(self):
        while self.alive:
            time.sleep(PING_EVERY)
            self.send(0, T_PING)

    def _readexact(self, n):
        buf = b""
        while len(buf) < n:
            c = self.proc.stdout.read(n - len(buf))
            if not c:
                return None
            buf += c
        return buf

    def run(self):
        threading.Thread(target=self.pinger, daemon=True).start()
        while True:
            h = self._readexact(HDR.size)
            if h is None:
                break
            sid, t, ln = HDR.unpack(h)
            payload = self._readexact(ln) if ln else b""
            if payload is None:
                break
            self.ready.set()
            if t == T_OPEN:
                self._open(sid)
            elif t == T_DATA:
                with self.lock:
                    conn = self.socks.get(sid)
                if conn is not None:
                    try:
                        conn.sendall(payload)
                    except OSError:
                        with self.lock:
                            self.socks.pop(sid, None)
            elif t == T_CLOSE:
                with self.lock:
                    conn = self.socks.pop(sid, None)
                if conn is not None:
                    try:
                        conn.close()
                    except OSError:
                        pass
        self.alive = False
        self.ready.set()


# --------------------------------------------------------------------------
# sprite plumbing
# --------------------------------------------------------------------------

def resolve_sprite(name):
    """`sprite` takes its target from -s or from a .sprite file in the current
    directory -- there is no other default. Establish that here rather than
    discovering it as an ssh failure after the credential is already loaded."""
    if name:
        return name
    if os.path.exists(".sprite"):
        return ""  # the sprite CLI reads it, exactly as it would anyway
    die("no sprite selected.",
        "  imp -s NAME",
        "or run `sprite use NAME` in this directory first.")


def wait_for_link(mux, proc, timeout):
    """The relay pings as soon as it is listening; that frame is the only
    honest signal that the sprite side exists."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if mux.ready.wait(0.25):
            return mux.alive
        if proc.poll() is not None:
            return False
    return False


def ssh_argv(sprite, remote_cmd):
    proxy_cmd = "sprite proxy --ssh"
    if sprite:
        proxy_cmd += " -s " + sprite
    return [
        "ssh",
        "-o", "ProxyCommand=" + proxy_cmd,
        "-o", "StrictHostKeyChecking=no",
        "-o", "UserKnownHostsFile=/dev/null",
        "-o", "LogLevel=ERROR",
        "-o", "ControlMaster=no",
        "-o", "ControlPath=none",
        "-o", "ServerAliveInterval=10",
        "-o", "ServerAliveCountMax=3",
        "sprite", remote_cmd,
    ]


SETTINGS_SCRIPT = r'''
import json, os, sys

base_url = sys.stdin.readline().strip()
capability = sys.stdin.readline().strip()

path = os.path.expanduser("~/.claude/settings.json")
try:
    with open(path) as f:
        data = json.load(f)
except (IOError, OSError):
    data = {}
except ValueError:
    sys.exit("existing settings.json is not valid JSON; refusing to touch it")

env = data.setdefault("env", {})
warn = ""
if "CLAUDE_CODE_OAUTH_TOKEN" in env:
    warn = "WARNING: a stored CLAUDE_CODE_OAUTH_TOKEN is present in settings.json"

if base_url:
    env["ANTHROPIC_BASE_URL"] = base_url
    env["ANTHROPIC_AUTH_TOKEN"] = capability
else:
    env.pop("ANTHROPIC_BASE_URL", None)
    env.pop("ANTHROPIC_AUTH_TOKEN", None)
    if not env:
        data.pop("env", None)

os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".imp.tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, path)
print("ok" + ((" | " + warn) if warn else ""))
'''


def remote_python(src, args=()):
    b64 = base64.b64encode(src.encode()).decode()
    argv = " ".join("'%s'" % a for a in args)
    return ("python3 -u -c \"exec(__import__('base64').b64decode('%s'))\" %s"
            % (b64, argv))


def write_sprite_settings(sprite, base_url, capability):
    """Install (or clear) the sprite's pointer at us. Neither value is a secret."""
    argv = ssh_argv(sprite, remote_python(SETTINGS_SCRIPT))
    r = subprocess.run(argv, input="%s\n%s\n" % (base_url, capability),
                       capture_output=True, text=True)
    if r.returncode != 0:
        return False, (r.stderr.strip() or "ssh failed")
    return True, r.stdout.strip()


# --------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        prog="imp",
        description="Lend a sprite your Claude Max subscription without giving "
                    "it the credential.",
        epilog="The credential never leaves this machine. Stop the proxy "
               "(Ctrl-C) and the sprite's access dies immediately -- running "
               "`claude` processes there simply start failing API calls, so "
               "revoking costs you nothing but a reconnect.")
    ap.add_argument("-s", "--sprite", default="",
                    help="sprite name (default: the one `sprite use` selected "
                         "in this directory)")
    ap.add_argument("-p", "--remote-port", type=int, default=8080,
                    help="port the relay listens on inside the sprite (default 8080)")
    ap.add_argument("--no-settings", action="store_true",
                    help="do not touch the sprite's ~/.claude/settings.json; "
                         "print the env vars for you to set yourself")
    ap.add_argument("--allow", action="append", default=[], metavar="GLOB",
                    help="allow an extra request path through; repeatable, "
                         "globs accepted")
    ap.add_argument("--allow-any-path", action="store_true",
                    help="disable the path allowlist entirely -- the proxy "
                         "becomes an open relay to your account for the "
                         "length of the session")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="log each proxied request")
    args = ap.parse_args()
    args.sprite = resolve_sprite(args.sprite)

    cred = Credential()
    capability = base64.urlsafe_b64encode(os.urandom(24)).decode().rstrip("=")
    log("credential loaded (%d chars) from %s" % (len(cred.token), cred.source))

    allowed = () if args.allow_any_path else DEFAULT_ALLOWED + tuple(args.allow)
    if allowed:
        log("path allowlist: %s" % " ".join(allowed))
    else:
        log("path allowlist DISABLED -- any path reaches your account")

    handler = make_proxy_handler(cred, capability, args.verbose, allowed)
    proxy = ProxyServer(("127.0.0.1", 0), handler)
    proxy_port = proxy.server_address[1]
    threading.Thread(target=proxy.serve_forever, daemon=True).start()
    log("injecting proxy on 127.0.0.1:%d (loopback only)" % proxy_port)

    remote = remote_python(RELAY_SRC, (str(args.remote_port), str(RELAY_IDLE_TIMEOUT)))
    proc = subprocess.Popen(ssh_argv(args.sprite, remote),
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=None, bufsize=0)

    def on_signal(signum, frame):
        try:
            proc.terminate()
        except OSError:
            pass

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    mux = Mux(proc, proxy_port, args.verbose)
    threading.Thread(target=mux.run, daemon=True).start()
    if not wait_for_link(mux, proc, LINK_TIMEOUT):
        log("no relay came up on sprite '%s' -- link failed or timed out."
            % (args.sprite or "(from .sprite)"))
        log("check `sprite ls` and that python3 exists on the sprite.")
        try:
            proc.terminate()
        except OSError:
            pass
        proxy.shutdown()
        return 1

    base_url = "http://127.0.0.1:%d" % args.remote_port
    settings_written = False
    if not args.no_settings:
        ok, msg = write_sprite_settings(args.sprite, base_url, capability)
        if ok:
            settings_written = True
            log("sprite settings.json points at the relay (%s)" % msg)
        else:
            log("could not write sprite settings.json: %s" % msg)
            log("set these on the sprite yourself:")
            log("  ANTHROPIC_BASE_URL=%s" % base_url)
            log("  ANTHROPIC_AUTH_TOKEN=%s" % capability)
    else:
        log("set these on the sprite yourself:")
        log("  ANTHROPIC_BASE_URL=%s" % base_url)
        log("  ANTHROPIC_AUTH_TOKEN=%s" % capability)

    log("ready -- `claude` on the sprite now runs on your Max subscription.")
    log("Ctrl-C revokes instantly. Nothing to clean up on the sprite.")

    try:
        while mux.alive and proc.poll() is None:
            time.sleep(0.25)
    finally:
        log("link closed -- sprite access revoked")
        try:
            proc.terminate()
        except OSError:
            pass
        if settings_written:
            ok, msg = write_sprite_settings(args.sprite, "", "")
            log("cleared sprite settings.json" if ok
                else "left an inert capability in settings.json (%s)" % msg)
        proxy.shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
