# the relay that runs on the sprite (shipped as base64 in argv, never a file)
# --------------------------------------------------------------------------

RELAY_SRC = r'''
import os, socket, struct, sys, threading, time

PORT = int(sys.argv[1])
IDLE = float(sys.argv[2])
HDR = struct.Struct("!IBI")
T_OPEN, T_DATA, T_CLOSE, T_PING = 1, 2, 3, 4

out = sys.stdout.buffer
inp = sys.stdin.buffer
outlock = threading.Lock()
streams = {}
slock = threading.Lock()
last = [time.time()]


def send(sid, t, payload=b""):
    with outlock:
        try:
            out.write(HDR.pack(sid, t, len(payload)))
            if payload:
                out.write(payload)
            out.flush()
        except (OSError, ValueError):
            os._exit(0)


def pump(sid, conn):
    try:
        while True:
            b = conn.recv(65536)
            if not b:
                break
            send(sid, T_DATA, b)
    except OSError:
        pass
    finally:
        with slock:
            streams.pop(sid, None)
        send(sid, T_CLOSE)
        try:
            conn.close()
        except OSError:
            pass


def acceptor():
    srv = socket.socket()
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind(("127.0.0.1", PORT))
    except OSError as e:
        sys.stderr.write("relay: cannot bind 127.0.0.1:%d: %s\n" % (PORT, e))
        sys.stderr.flush()
        os._exit(1)
    srv.listen(64)
    sys.stderr.write("relay listening on 127.0.0.1:%d\n" % PORT)
    sys.stderr.flush()
    # Tell the other end the link is genuinely up. Nothing is "ready" before
    # this frame arrives.
    send(0, T_PING)
    n = 0
    while True:
        conn, _ = srv.accept()
        n += 1
        with slock:
            streams[n] = conn
        send(n, T_OPEN)
        threading.Thread(target=pump, args=(n, conn), daemon=True).start()


def watchdog():
    # The sprite keeps remote commands alive after the link drops, so nothing
    # tears us down for free. Silence means the operator is gone: exit, which
    # closes every proxied connection and frees the port.
    while True:
        time.sleep(2)
        if time.time() - last[0] > IDLE:
            sys.stderr.write("relay: %.0fs silent, exiting\n" % IDLE)
            os._exit(0)


def readexact(n):
    buf = b""
    while len(buf) < n:
        c = inp.read(n - len(buf))
        if not c:
            return None
        buf += c
    return buf


threading.Thread(target=acceptor, daemon=True).start()
threading.Thread(target=watchdog, daemon=True).start()

while True:
    h = readexact(HDR.size)
    if h is None:
        break
    sid, t, ln = HDR.unpack(h)
    payload = readexact(ln) if ln else b""
    if payload is None:
        break
    last[0] = time.time()
    if t == T_PING:
        continue
    with slock:
        conn = streams.get(sid)
    if conn is None:
        continue
    if t == T_DATA:
        try:
            conn.sendall(payload)
        except OSError:
            with slock:
                streams.pop(sid, None)
            try:
                conn.close()
            except OSError:
                pass
    elif t == T_CLOSE:
        with slock:
            streams.pop(sid, None)
        try:
            conn.close()
        except OSError:
            pass
os._exit(0)
'''


# --------------------------------------------------------------------------
# this side of the mux
# --------------------------------------------------------------------------

class Mux(object):
    """Demultiplexes the sprite's framed stdout into local proxy connections."""

    def __init__(self, proc, proxy_port, verbose):
        self.proc = proc
        self.proxy_port = proxy_port
        self.verbose = verbose
        self.socks = {}
        self.lock = threading.Lock()
        self.wlock = threading.Lock()
        self.alive = True
        self.ready = threading.Event()

    def send(self, sid, t, payload=b""):
        with self.wlock:
            try:
                self.proc.stdin.write(HDR.pack(sid, t, len(payload)))
                if payload:
                    self.proc.stdin.write(payload)
                self.proc.stdin.flush()
            except (OSError, ValueError):
                self.alive = False

    def _pump(self, sid, conn):
        try:
            while True:
                b = conn.recv(65536)
                if not b:
                    break
                self.send(sid, T_DATA, b)
        except OSError:
            pass
        finally:
            with self.lock:
                self.socks.pop(sid, None)
            self.send(sid, T_CLOSE)
            try:
                conn.close()
            except OSError:
                pass

    def _open(self, sid):
        with self.lock:
            if len(self.socks) >= MAX_STREAMS:
                log("refusing stream %d: %d already open" % (sid, MAX_STREAMS))
                self.send(sid, T_CLOSE)
                return
            stale = self.socks.pop(sid, None)
        if stale is not None:
            # A repeated SID used to overwrite the entry and leak the socket.
            try:
                stale.close()
            except OSError:
                pass
        try:
            conn = socket.create_connection(("127.0.0.1", self.proxy_port), timeout=10)
            conn.settimeout(None)
        except OSError as e:
            log("could not reach local proxy: %r" % (e,))
            self.send(sid, T_CLOSE)
            return
        with self.lock:
            self.socks[sid] = conn
        threading.Thread(target=self._pump, args=(sid, conn), daemon=True).start()

    def pinger(self):
        while self.alive:
            time.sleep(PING_EVERY)
            self.send(0, T_PING)

    def _readexact(self, n):
        # Chunks into a list rather than repeatedly concatenating: `buf += c`
        # over a large frame is quadratic.
        parts, got = [], 0
        while got < n:
            c = self.proc.stdout.read(n - got)
            if not c:
                return None
            parts.append(c)
            got += len(c)
        return b"".join(parts)

    def run(self):
        threading.Thread(target=self.pinger, daemon=True).start()
        while True:
            h = self._readexact(HDR.size)
            if h is None:
                break
            sid, t, ln = HDR.unpack(h)
            if ln > MAX_FRAME:
                # The length is a uint32 chosen by the far end. Allocating on
                # its say-so is how the sprite OOMs this machine; the relay
                # never legitimately sends more than 64KB.
                log("frame of %d bytes exceeds the %d byte limit -- "
                    "closing the link" % (ln, MAX_FRAME))
                break
            payload = self._readexact(ln) if ln else b""
            if payload is None:
                break
            self.ready.set()
            if t == T_OPEN:
                self._open(sid)
            elif t == T_DATA:
                with self.lock:
                    conn = self.socks.get(sid)
                if conn is not None:
                    try:
                        conn.sendall(payload)
                    except OSError:
                        with self.lock:
                            self.socks.pop(sid, None)
            elif t == T_CLOSE:
                with self.lock:
                    conn = self.socks.pop(sid, None)
                if conn is not None:
                    try:
                        conn.close()
                    except OSError:
                        pass
        self.alive = False
        self.ready.set()


# --------------------------------------------------------------------------
# sprite plumbing
# --------------------------------------------------------------------------

def resolve_sprite(name):
    """`sprite` takes its target from -s or from a .sprite file in the current
    directory -- there is no other default. Establish that here rather than
    discovering it as an ssh failure after the credential is already loaded."""
    if name:
        return name
    if os.path.exists(".sprite"):
        return ""  # the sprite CLI reads it, exactly as it would anyway
    die("no sprite selected.",
        "  imp -s NAME",
        "or run `sprite use NAME` in this directory first.")


def wait_for_link(mux, proc, timeout):
    """The relay pings as soon as it is listening; that frame is the only
    honest signal that the sprite side exists."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if mux.ready.wait(0.25):
            return mux.alive
        if proc.poll() is not None:
            return False
    return False


def ssh_argv(sprite, remote_cmd):
    proxy_cmd = "sprite proxy --ssh"
    if sprite:
        proxy_cmd += " -s " + sprite
    return [
        "ssh",
        "-o", "ProxyCommand=" + proxy_cmd,
        "-o", "StrictHostKeyChecking=no",
        "-o", "UserKnownHostsFile=/dev/null",
        "-o", "LogLevel=ERROR",
        "-o", "ControlMaster=no",
        "-o", "ControlPath=none",
        "-o", "ServerAliveInterval=10",
        "-o", "ServerAliveCountMax=3",
        "sprite", remote_cmd,
    ]


