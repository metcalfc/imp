#!/bin/bash
# imp — get a sprite console with imp-proxy already running beside it.
#
# Sugar, nothing more. These are two commands you could type yourself:
#
#     imp-proxy -s NAME          # lend the sprite your subscription
#     sprite console -s NAME     # get a shell on it
#
# or, for any host you can ssh to:
#
#     imp-proxy -H box
#     ssh -t box
#
# You would type the sprite name twice and juggle two terminals. This types it
# once and puts them in one tmux window -- console on top, the proxy's log in
# a strip along the bottom where you can see `ready`, `rejected:` and the rest
# of what it has to say.
#
# Everything of consequence stays in imp-proxy: the credential, the path
# allowlist, the capability. This script never touches any of them, and it
# deliberately validates nothing imp-proxy validates -- no sprite selected is
# imp-proxy's error to report, in the words it already uses.
#
# tmux is not required. Without it this is exactly `imp-proxy`, and you open a
# console wherever you like.

set -euo pipefail

die() { printf 'imp: %s\n' "$*" >&2; exit 1; }

usage() {
  cat >&2 <<'USAGE'
usage: imp [-s NAME | -H HOST] [imp-proxy options...]

Opens a tmux window: a console above, `imp-proxy` below. -s gets you a sprite
console, -H an ssh session to any host you own. Every option
is passed through to imp-proxy untouched -- see `imp-proxy --help`.

Ctrl-C in the lower pane revokes the sprite's access, exactly as it always
has, and takes the pane with it -- leaving you the console, now unfunded.
Closing the window revokes too.

To lend it again without a fresh window: split and run imp-proxy yourself.
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

# imp-proxy from this checkout before one on PATH. You will at some point be
# testing a modified proxy while a released one is installed, and picking the
# wrong one is a confusing afternoon.
here=$(cd -- "$(dirname -- "$0")" && pwd)
proxy="$here/imp-proxy"
[ -x "$proxy" ] || proxy=imp-proxy

# Two things are wanted from the arguments: which console to open, and a name
# to label the tmux window with. imp-proxy does the real resolution and owns
# every error about it, so a failure to work either out is not fatal here.
sprite=""
host=""
prev=""
for arg in "$@"; do
  case "$prev" in
    -s|--sprite) sprite="$arg" ;;
    -H|--host)   host="$arg" ;;
  esac
  prev="$arg"
done

if [ -n "$host" ]; then
  console="ssh -t $(printf '%q' "$host")"
  name="$host"
elif [ -n "$sprite" ]; then
  console="sprite console -s $(printf '%q' "$sprite")"
  name="$sprite"
else
  # No -s: plain `sprite console`, so the CLI resolves .sprite by its own
  # rules rather than by ours. .sprite is read here for the window label and
  # nothing else -- if the two ever disagree about which file counts, the
  # label is the harmless place for that to show up.
  console="sprite console"
  [ -r .sprite ] && read -r sprite < .sprite
  name="${sprite:-sprite}"
fi
label=${name//[^A-Za-z0-9_-]/-}

if ! command -v tmux >/dev/null 2>&1; then
  printf 'imp: no tmux -- running the proxy here.\n' >&2
  printf 'imp: open a console elsewhere with: sprite console\n' >&2
  exec "$proxy" "$@"
fi

# tmux wants one command string, so the passthrough has to survive being
# re-parsed by a shell. printf %q is what makes that safe rather than hopeful.
cmd=$(printf '%q' "$proxy")
for arg in "$@"; do
  cmd="$cmd $(printf '%q' "$arg")"
done

if [ -n "${TMUX:-}" ]; then
  win=$(tmux new-window -P -F '#{window_id}' -n "imp:$label" "$console")
  attach=""
else
  session="imp-$label"
  if ! win=$(tmux new-session -d -s "$session" -P -F '#{window_id}' \
             -n "imp:$label" "$console" 2>/dev/null); then
    die "tmux session '$session' already exists -- try: tmux attach -t $session"
  fi
  attach="$session"
fi

# -d keeps the cursor in the console; the proxy is there to be read, not typed
# into. Eight lines is its whole startup banner with nothing scrolled off.
pane=$(tmux split-window -v -l 8 -d -t "$win" -P -F '#{pane_id}' "$cmd")

# `failed`, not `on`. Ctrl-C is imp-proxy's clean exit -- it tears down and
# returns 0 -- so the pane closes with it and you are left with the console,
# which is the whole shape of revoking. A proxy that dies for a reason exits
# non-zero and its pane stays put with the reason still on screen.
#
# Pane options need tmux 3.0 and the `failed` value 3.2; older tmux falls back
# to keeping every dead pane, and older still does without.
tmux set-option -p -t "$pane" remain-on-exit failed 2>/dev/null \
  || tmux set-option -p -t "$pane" remain-on-exit on 2>/dev/null \
  || true

[ -z "$attach" ] || exec tmux attach -t "$attach"
