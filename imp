#!/bin/bash
# imp — three claude sessions on a sprite, with imp-proxy funding them.
#
# Sugar, nothing more. These are commands you could type yourself:
#
#     imp-proxy -s NAME          # lend the sprite your subscription
#     sprite console -s NAME     # get a shell on it, then run `claude`
#
# or, for any host you can ssh to:
#
#     imp-proxy -H box
#     ssh -t box
#
# You would type the name once per terminal and watch the proxy in none of
# them. This types it once and lays out a tmux session:
#
#     window 0  imp:NAME      the proxy, and its log
#     window 1  claude:NAME   a console with `claude` running in it
#     window 2  claude:NAME
#     window 3  claude:NAME
#
# Ctrl-B n walks all four. Ctrl-B C-n walks only the claude windows, which is
# the one you want when you are actually working; Ctrl-B C-p goes back.
# Ctrl-B T puts every claude in one tiled window, to watch all three at once,
# and puts them back.
#
# Everything of consequence stays in imp-proxy: the credential, the path
# allowlist, the capability. This script never touches any of them. It does
# not parse the arguments either -- it asks imp-proxy what they meant. An
# earlier version scanned for `-s NAME` in bash and so did not recognise
# -sNAME, --sprite=NAME or --spr NAME, all of which imp-proxy accepts; each
# one funded one machine and opened a console on another. There is one
# parser now, and it is argparse.
#
# Ctrl-C in the proxy window revokes access, which is a thing you do on
# purpose and a thing you do by accident with three claudes still open.
# `imp -s NAME --reattach` is the way back from the second case: a proxy
# window back in the session, funding the consoles that are already there.
#
# tmux is not required. Without it this is exactly `imp-proxy`, and you open
# consoles wherever you like.

set -euo pipefail

die() { printf 'imp: %s\n' "$*" >&2; exit 1; }

# The label out of a list of window names on stdin -- `claude:foo` or
# `imp:foo` means the session belongs to an imp session called foo.
#
# All of the input is read, and the first match is held until there is no
# more. `... | head -n 1` is the obvious way to write that and is wrong here
# for the reason the reaper gives: head exits at the first line, whatever is
# upstream dies of SIGPIPE, and under `set -o pipefail` the assignment that
# wraps the pipeline fails -- so `set -e` ends the script, sometimes, when
# the writer happened to still be writing.
first_label() {
  awk -F: '($1 == "claude" || $1 == "imp") && !seen++ { label = $2 }
           END { if (label != "") print label }'
}

usage() {
  cat >&2 <<'USAGE'
usage: imp [-s NAME | -H HOST] [-n COUNT] [--reattach] [imp-proxy options...]

Opens a tmux session: imp-proxy in the first window, then COUNT console
windows (3 by default) each running `claude`. -s gets you sprite consoles,
-H ssh sessions to any host you own. Every option is passed through to
imp-proxy untouched -- see `imp-proxy --help`.

  Ctrl-B n      next window, including the proxy
  Ctrl-B C-n    next claude window, skipping the proxy  (C-p for previous)
  Ctrl-B T      every claude in one tiled window, and back to a window each

`claude` is started in each console once the proxy reports ready, not before:
it reads settings.json at startup, and settings.json is what imp-proxy is
still writing for the first second or two.

Ctrl-C in the proxy window revokes access, exactly as it always has, and
takes that window with it -- leaving the consoles, now unfunded. Closing the
last claude window revokes too, and ends the session.

    imp -s NAME --reattach

is the way back from the first of those when you did not mean it. It puts a
proxy window back in front of the consoles it left, in the session they are
still sitting in, and imp-proxy hands the far side the same capability those
claudes are already holding -- so they resume rather than restart. It opens
no consoles and types no `claude`.
USAGE
}

# Hidden, and not for people: the tmux hook at the bottom calls this whenever
# a window closes. Keeping it here rather than inline in the hook means the
# logic is bash that can be read and tested, not a string escaped through
# tmux's parser and then a shell's.
if [ "${1:-}" = --reap ]; then
  [ $# -eq 3 ] || exit 0
  reap_label=$2; reap_win=$3
  # Two things here are deliberate, and both were bugs that ended a healthy
  # session about half a second after imp built it.
  #
  # A window id (@7), never a session id ($2): the hook body is re-read by
  # /bin/sh, where a session id beginning with `$` becomes the shell's own
  # $2 and addresses nothing. A window id resolves to its session for both
  # commands below and contains no character sh wants.
  #
  # And no pipe into `grep -q`: under `set -o pipefail` grep exits at the
  # first match, tmux takes SIGPIPE writing to the closed pipe, and the
  # pipeline reports failure -- so a session full of consoles read as none.
  reap_names=$(tmux list-windows -t "$reap_win" -F '#{window_name}' 2>/dev/null || true)
  if ! grep -qx "claude:$reap_label" <<EOF
$reap_names
EOF
  then
    # The last console is gone, so nothing is left for the proxy to fund.
    # Unhook before killing: afterwards there is no window to address.
    # Killing the window sends the proxy SIGHUP, which it handles -- the far
    # side's settings.json is cleared on the way out. In a session imp
    # created this also empties it, and tmux ends the session for us.
    tmux set-hook -u -t "$reap_win" window-unlinked 2>/dev/null || true
    tmux kill-window -t "$reap_win" 2>/dev/null || true
  fi
  exit 0
fi

# Hidden too, and called by the Ctrl-B T binding with the window the key was
# pressed in -- tmux expands #{window_id} in a run-shell command, so nothing
# here has to guess which session is being asked about. A window id and not a
# session id, for the reason the reaper gives.
#
# Three consoles are three windows, which is the right shape for working in
# one of them and the wrong one for watching all three at once. So this
# toggles: every console pane into a single tiled window, and back out to a
# window each. Ctrl-B z then zooms one of them, which is tmux's own job.
#
# The proxy is left where it is, in both directions. It owns the reaper hook
# and Ctrl-C in it means revoke; neither wants to be a pane in a window full
# of claudes. That it stays a window is also what keeps the reaper right
# while tiled -- the merged window is still named `claude:LABEL`, so the
# console count is 1 and not 0, and the last console closing still takes the
# proxy with it.
if [ "${1:-}" = --tile ]; then
  [ $# -eq 2 ] || exit 0
  tile_win=$2
  tile_session=$(tmux display-message -p -t "$tile_win" '#{session_name}' \
                 2>/dev/null || true)
  [ -n "$tile_session" ] || exit 0

  # The label off a window name rather than off the session name: run inside
  # an existing tmux, imp puts its windows in a session somebody else named.
  tile_name=$(tmux display-message -p -t "$tile_win" '#{window_name}' \
              2>/dev/null || true)
  case "$tile_name" in
    claude:*|imp:*) tile_label=${tile_name#*:} ;;
    *) tile_label=$(tmux list-windows -t "=$tile_session" -F '#{window_name}' \
                    2>/dev/null | first_label) || tile_label="" ;;
  esac
  [ -n "$tile_label" ] || exit 0

  # The console panes, in window order, which is the order they keep.
  tile_panes=$(tmux list-panes -s -t "=$tile_session" \
               -F '#{window_id} #{pane_id} #{window_name}' 2>/dev/null \
               | awk -v want="claude:$tile_label" '$3 == want { print $1" "$2 }')
  [ -n "$tile_panes" ] || exit 0
  tile_host=$(printf '%s\n' "$tile_panes" | awk 'NR == 1 { print $1 }')
  tile_count=$(printf '%s\n' "$tile_panes" \
               | awk '{ if (!($1 in seen)) { seen[$1] = 1; n++ } } END { print n+0 }')
  tile_active=$(tmux display-message -p -t "$tile_win" '#{pane_id}' \
                2>/dev/null || true)

  if [ "$tile_count" -gt 1 ]; then
    # Each pane joins onto the one joined before it. Joining them all onto
    # the host would reverse them -- a joined pane lands beside the target,
    # and the target would not move. And a layout after every join rather
    # than one at the end: a window with no room left refuses the next pane
    # instead of making room for it.
    tile_after=$(printf '%s\n' "$tile_panes" | awk 'NR == 1 { print $2 }')
    for tile_p in $(printf '%s\n' "$tile_panes" \
                    | awk -v host="$tile_host" '$1 != host { print $2 }'); do
      tmux join-pane -d -s "$tile_p" -t "$tile_after" 2>/dev/null || continue
      tile_after=$tile_p
      tmux select-layout -t "$tile_host" tiled 2>/dev/null || true
    done
    tmux select-layout -t "$tile_host" tiled 2>/dev/null || true
    tmux select-window -t "$tile_host" 2>/dev/null || true
    [ -z "$tile_active" ] || tmux select-pane -t "$tile_active" 2>/dev/null || true
  else
    # Back out: every pane but the first becomes a window again, each one
    # after the last, so they return in the order they were tiled in. Named
    # on the way out because the reaper counts consoles by name -- a window
    # called `sh` is not one, and three of them would leave the proxy funding
    # what it thinks is nothing. -a wants tmux 3.2; without it they land at
    # the end of the session, in order, which reads very slightly wrong.
    tile_prev=$tile_host
    tile_first=1
    for tile_p in $(printf '%s\n' "$tile_panes" | awk '{ print $2 }'); do
      if [ "$tile_first" = 1 ]; then tile_first=0; continue; fi
      tile_new=$(tmux break-pane -d -a -s "$tile_p" -t "$tile_prev" \
                 -n "claude:$tile_label" -P -F '#{window_id}' 2>/dev/null) \
        || tile_new=""
      [ -n "$tile_new" ] \
        || tile_new=$(tmux break-pane -d -s "$tile_p" -n "claude:$tile_label" \
                      -P -F '#{window_id}' 2>/dev/null) || tile_new=""
      [ -n "$tile_new" ] || continue
      tmux set-option -w -t "$tile_new" automatic-rename off 2>/dev/null || true
      tile_prev=$tile_new
    done
    [ -z "$tile_active" ] || tmux select-window -t "$tile_active" 2>/dev/null || true
  fi
  exit 0
fi

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

# imp-proxy from this checkout before one on PATH. You will at some point be
# testing a modified proxy while a released one is installed, and picking the
# wrong one is a confusing afternoon.
here=$(cd -- "$(dirname -- "$0")" && pwd)
proxy="$here/imp-proxy"
[ -x "$proxy" ] || proxy=imp-proxy

# What the arguments meant, from the program that defines them. Its stderr is
# left alone, so a bad option is reported by imp-proxy in imp-proxy's words --
# and its exit status is ours. ("unrecognized arguments: --print-console"
# here means an imp-proxy older than this imp is first on PATH.)
meta=$("$proxy" --print-console "$@") || exit $?

# Not a console spec. `--help` among the arguments is how that happens --
# argparse prints and exits before --print-console is ever looked at -- so
# hand whatever it said straight on rather than inventing an error about it.
case "$meta" in
  *mode=*) ;;
  *) printf '%s\n' "$meta"; exit 0 ;;
esac

mode=""; label=""; consoles=""; console=""; reattach=0
while IFS= read -r line; do
  case "$line" in
    mode=*)     mode=${line#mode=} ;;
    reattach=*) reattach=${line#reattach=} ;;
    label=*)    label=${line#label=} ;;
    consoles=*) consoles=${line#consoles=} ;;
    console=*)  console=${line#console=} ;;
  esac
done <<EOF
$meta
EOF
[ -n "$console" ] && [ -n "$label" ] && [ -n "$consoles" ] \
  || die "imp-proxy did not say what to open"

# --clear and anything else that is not a session gets no windows -- it runs
# and exits.
[ "$mode" = session ] || exec "$proxy" "$@"

if ! command -v tmux >/dev/null 2>&1; then
  printf 'imp: no tmux -- running the proxy here.\n' >&2
  printf 'imp: open consoles elsewhere with: %s\n' "$console" >&2
  exec "$proxy" "$@"
fi

session="imp-$label"

# `failed`, not `on`. Ctrl-C is imp-proxy's clean exit -- it tears down and
# returns 0 -- so the window closes with it and you are left with the
# consoles, which is the whole shape of revoking. A proxy that dies for a
# reason exits non-zero and its window stays put, reason still on screen.
#
# Pane options need tmux 3.0 and the `failed` value 3.2; older tmux falls back
# to keeping every dead pane, and older still does without.
proxy_pane_options() {
  local win=$1
  tmux set-option -p -t "$win" remain-on-exit failed 2>/dev/null \
    || tmux set-option -p -t "$win" remain-on-exit on 2>/dev/null \
    || true
}

# Ctrl-B C-n / C-p: step one window, and step again if that landed on the
# proxy. Both keys are unbound in tmux's default prefix table. Bindings are
# server-global -- there is no session-local key table -- so this is written
# to be harmless in your other sessions: it is next-window/previous-window
# that happens to skip windows named `imp:*`, and nothing else has that name.
# The whole chain has to arrive as one argument. A bare `;` between them is
# read by tmux as the separator between two *top-level* commands, so
# `bind-key ... select-window ; if-shell ...` binds only the select-window
# and runs the if-shell once, immediately, at bind time -- a binding that
# looks right in list-keys until you notice it is half as long as it should
# be, and lands on the proxy every third press.
bind_step_keys() {
  local k key step
  for k in 'C-n :+' 'C-p :-'; do
    key=${k%% *}; step=${k##* }
    tmux bind-key -T prefix "$key" \
      "select-window -t $step ; if-shell -F '#{m:imp:*,#{window_name}}' 'select-window -t $step'" \
      2>/dev/null || true
  done
}

# Ctrl-B T: the consoles as one tiled window, and back again. T because it is
# unbound in tmux's defaults -- `t` is the clock, and taking that away from
# every session on the server to save a Shift is a poor trade. Harmless
# elsewhere for the same reason the step keys are: in a session with no
# `claude:` windows the script finds no label and does nothing at all.
bind_tile_key() {
  tmux bind-key -T prefix T \
    "run-shell -b '\"$here/imp\" --tile #{window_id}'" 2>/dev/null || true
}

# When the last console closes, take the proxy down with it. Ctrl-C in the
# proxy window is the other direction and must not trigger this, which is why
# the reaper counts `claude:` windows rather than watching any single pane.
#
# Single quotes for tmux, double quotes for the shell inside them, so a
# checkout path with a space in it survives both parsers.
arm_reaper() {
  local win=$1
  tmux set-hook -t "$win" window-unlinked \
    "run-shell -b '\"$here/imp\" --reap $label $win'" 2>/dev/null || true
}

# tmux wants one command string, so the passthrough has to survive being
# re-parsed by a shell. printf %q is what makes that safe rather than hopeful.
#
# `exec`, and it is load-bearing. tmux runs a pane's command through a shell,
# and whether that shell replaces itself with the command or sits in front of
# it as a parent is the shell's business, not ours: bash and zsh exec, dash
# does not. When it does not, Ctrl-C kills the *shell* -- tmux reports "Pane
# is dead (signal 2)", which remain-on-exit=failed rightly treats as a
# failure -- so the proxy tore down cleanly and its window stayed open
# anyway, wearing a dead pane. exec makes the pane process imp-proxy
# everywhere, so the signal and the exit status are always its own.
cmd="exec $(printf '%q' "$proxy")"
# The same arguments without --reattach, for the one message that has to name
# the command that would have built this session. `--rea` is as short as
# argparse lets that option be abbreviated -- `--re` is ambiguous with
# --remote-port -- so that is what the pattern matches.
plain=""
for arg in "$@"; do
  cmd="$cmd $(printf '%q' "$arg")"
  case "$arg" in --rea*) continue ;; esac
  plain="$plain $(printf '%q' "$arg")"
done

# --reattach: the consoles outlived their proxy, and they are the expensive
# half -- three claudes with three conversations in them. So nothing here
# creates or types into a console. It hangs a proxy window back on the front
# of the session and gets out of the way; imp-proxy does the part that
# matters, which is handing the far side the capability those claudes are
# still holding in their environment.
if [ "$reattach" != 0 ]; then
  tmux has-session -t "=$session" 2>/dev/null \
    || die "no session '$session' to reattach to -- open one with: imp$plain"

  # No pipe into `grep -q`, for the reason spelled out in the reaper: under
  # pipefail, grep exiting at the first match reads as tmux having failed.
  names=$(tmux list-windows -t "=$session" -F '#{window_name}' 2>/dev/null || true)
  if grep -qx "imp:$label" <<EOF
$names
EOF
  then
    printf 'imp: %s already has a proxy window -- nothing to put back.\n' \
           "$session" >&2
  else
    # In front of the first console, where the proxy was. Ctrl-B C-n knows it
    # by name and would step over it at any index, but a session that comes
    # back in a different order than it left is one you have to re-read.
    # -b wants tmux 3.2; without it the window lands at the end, which is a
    # session that works and reads slightly wrong.
    first=$(tmux list-windows -t "=$session" -F '#{window_id} #{window_name}' \
            | awk -v want="claude:$label" '$2 == want { print $1; exit }')
    win=""
    if [ -n "$first" ]; then
      win=$(tmux new-window -b -t "$first" -P -F '#{window_id}' \
            -n "imp:$label" "$cmd" 2>/dev/null) || win=""
    fi
    if [ -z "$win" ]; then
      win=$(tmux new-window -t "=$session" -P -F '#{window_id}' \
            -n "imp:$label" "$cmd") || die "tmux could not open a window"
    fi
    proxy_pane_options "$win"
    bind_step_keys
    bind_tile_key
    arm_reaper "$win"
  fi

  # Attached to nothing if someone is already looking. The way a session
  # loses its proxy is a Ctrl-C in a window you are still sitting in, and
  # answering that by stealing whichever terminal `imp` was typed into --
  # possibly the one running the claude that suggested this -- is not a fix.
  [ -z "${TMUX:-}" ] || exit 0
  clients=$(tmux list-clients -t "=$session" -F '#{client_name}' 2>/dev/null || true)
  [ -z "$clients" ] || exit 0
  exec tmux attach -t "=$session"
fi

# The proxy signals through a file rather than the log, and imp waits on it
# before starting `claude` anywhere. See --ready-file in imp-proxy.
ready_dir=$(mktemp -d "${TMPDIR:-/tmp}/imp.XXXXXX")
ready="$ready_dir/ready"
cmd="$cmd --ready-file $(printf '%q' "$ready")"

# The proxy takes the first window; the consoles follow it, so the `claude:`
# windows are contiguous and the proxy is the one thing Ctrl-B C-n has to
# step over. (Which index that is depends on your base-index, so nothing
# below counts windows -- it goes by name.)
if [ -n "${TMUX:-}" ]; then
  win=$(tmux new-window -P -F '#{window_id}' \
        -n "imp:$label" "$cmd") || die "tmux could not open a window"
  attach=""
else
  if ! win=$(tmux new-session -d -s "$session" -P -F '#{window_id}' \
             -n "imp:$label" "$cmd" 2>/dev/null); then
    die "tmux session '$session' already exists -- try: tmux attach -t $session"
  fi
  attach="$session"
fi
[ -n "$win" ] || die "tmux did not name the window it opened"

proxy_pane_options "$win"

# The consoles. All share one window name: the reaper counts them by it, and
# Ctrl-B C-n tells them from the proxy by it, so it is load-bearing. -n turns
# automatic-rename off by itself, but say so anyway -- a shell that sets the
# title would otherwise quietly rename a window out of both mechanisms.
panes=""
i=0
while [ "$i" -lt "$consoles" ]; do
  i=$((i + 1))
  # exec, for the same reason as the proxy: leaving the console should be
  # the console's exit status, not a wrapper shell's.
  p=$(tmux new-window -a -t "$win" -P -F '#{pane_id}' \
      -n "claude:$label" "exec $console") || die "tmux could not open console $i"
  tmux set-option -w -t "$p" automatic-rename off 2>/dev/null || true
  panes="$panes $p"
done

# Land on the first console rather than the proxy: the proxy is there to be
# read, not typed into, and this is a working session.
tmux select-window -t "$win" 2>/dev/null || true
tmux select-window -t :+ 2>/dev/null || true

bind_step_keys
bind_tile_key
arm_reaper "$win"

# `claude` last, and only once the proxy says the far side is funded: it reads
# settings.json at startup, and imp-proxy is still writing it for the first
# second or two. Backgrounded so the attach below is immediate -- you get the
# session while this is still waiting, and watch `claude` start in each
# window. Typed in rather than run as the console's command because
# `sprite console` takes no command to run.
(
  n=0
  while [ ! -e "$ready" ] && [ "$n" -lt 600 ]; do
    sleep 0.2
    n=$((n + 1))
    # Nothing to wait for if the proxy is already gone.
    tmux list-windows -t "$win" >/dev/null 2>&1 || break
  done
  if [ -e "$ready" ]; then
    for p in $panes; do
      tmux send-keys -t "$p" 'claude' Enter 2>/dev/null || true
    done
  fi
  rm -rf "$ready_dir"
) >/dev/null 2>&1 &

[ -z "$attach" ] || exec tmux attach -t "$attach"
